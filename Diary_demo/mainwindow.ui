  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #F5F2EB;
    color: #333333;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 14px;
}
QFrame#noteCard {
    background-color: #FFFDF8;
    border: 1px solid #DED8CC;
    border-radius: 12px;
}
QLabel#appTitle {
    color: #3D5A4C;
    font-size: 24px;
    font-weight: 700;
}
QLabel#tipLabel, QLabel#statusLabel {
    color: #8A8378;
    font-size: 12px;
}
QLineEdit#titleEdit, QTextEdit#contentEdit, QListWidget#diaryListWidget {
    background-color: white;
    border: 1px solid #D9D3C8;
    border-radius: 8px;
    padding: 9px;
    selection-background-color: #7FA18D;
}
QLineEdit#titleEdit:focus, QTextEdit#contentEdit:focus, QListWidget#diaryListWidget:focus {
    border: 1px solid #6E927C;
}
QListWidget#diaryListWidget {
    outline: none;
    padding: 5px;
}
QListWidget#diaryListWidget::item {
    min-height: 38px;
    padding: 4px 8px;
    border-radius: 6px;
}
QListWidget#diaryListWidget::item:selected {
    background-color: #DCE8E0;
    color: #294235;
}
QPushButton {
    min-height: 36px;
    border-radius: 8px;
    padding: 0 18px;
    font-weight: 600;
}
QPushButton#newButton, QPushButton#deleteButton, QPushButton#clearButton {
    background-color: #EEEAE2;
    color: #4D4A45;
    border: 1px solid #D9D3C8;
}
QPushButton#newButton:hover, QPushButton#deleteButton:hover, QPushButton#clearButton:hover {
    background-color: #E3DED4;
}
QPushButton#saveButton {
    background-color: #6E927C;
    color: white;
    border: none;
}
QPushButton#saveButton:hover {
    background-color: #5D806B;
}</string>
