QFrame#welcomeCard, QFrame#side, QFrame#editor { background: #151D31; border: 1px solid #263451; border-radius: 22px; }
QFrame#welcomeCard { background: rgba(21, 29, 49, 235); }
QLabel#logoBadge { background: #6C63FF; color: white; border-radius: 32px; font-size: 30px; font-weight: 700; }
QLabel#welcomeTitle { font-size: 34px; font-weight: 700; color: #F6F8FF; }
QLabel#welcomeSubtitle, QLabel#editorSubtitle, QLabel#countLabel, QLabel#emptyHint { color: #94A3C7; }
QLabel#brandLabel { font-size: 20px; font-weight: 700; color: #F3F6FF; }
QLabel#editorTitle { font-size: 24px; font-weight: 700; color: #F4F7FF; }
QLabel#sectionTitle { font-size: 15px; font-weight: 700; color: #DDE6FF; }
QLabel[field=&quot;true&quot;] { color: #AAB7D5; font-size: 12px; font-weight: 600; }
QPushButton { min-height: 40px; padding: 0 18px; border-radius: 10px; border: 1px solid #334364; background: #202B45; color: #EAF0FF; font-weight: 600; }
QPushButton:hover { background: #293858; border-color: #53698F; }
QPushButton:pressed { background: #1A243A; }
QPushButton#startBtn, QPushButton#saveBtn { background: #6C63FF; border: 1px solid #817AFF; color: white; }
QPushButton#startBtn:hover, QPushButton#saveBtn:hover { background: #7C74FF; }
QPushButton#startBtn { min-height: 48px; border-radius: 14px; font-size: 15px; }
QPushButton#backBtn { background: transparent; border: none; color: #9DABD0; padding: 0 8px; }
QLineEdit, QComboBox, QPlainTextEdit { background: #0E1527; border: 1px solid #2A3857; border-radius: 10px; color: #EDF2FF; selection-background-color: #6C63FF; padding: 9px 11px; }
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border: 1px solid #746CFF; background: #111A30; }
QComboBox { min-height: 22px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView { background: #151D31; color: #EDF2FF; border: 1px solid #334364; selection-background-color: #6C63FF; }
QListWidget { background: transparent; border: none; outline: none; color: #DCE5FA; }
QListWidget::item { background: #10182B; border: 1px solid #263451; border-radius: 10px; margin: 3px 0; }
QListWidget::item:hover { background: #1B2742; border-color: #405174; }
QListWidget::item:selected { background: #292A57; border: 1px solid #6C63FF; color: white; }
QLabel#statusLabel { color: #F2A6A6; }
QLabel#statusLabel[success=&quot;true&quot;] { color: #6EE7B7; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #344260; border-radius: 4px; min-height: 26px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
