  </property>
  <property name="styleSheet">
   <string notr="true"><![CDATA[
QMainWindow {
    background-color: #f3f6fb;
}

QWidget#centralwidget {
    background-color: #f3f6fb;
}

QLabel#titleLabel {
    color: #1f2937;
    font-size: 28px;
    font-weight: 700;
    padding: 10px 0px 0px 0px;
}

QLabel#subTitleLabel {
    color: #6b7280;
    font-size: 13px;
    padding-bottom: 8px;
}

QFrame#leftCard,
QFrame#centerCard,
QFrame#rightCard {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
}

QLabel#accountLabel,
QLabel#addLabel,
QLabel#detailLabel {
    color: #111827;
    font-size: 16px;
    font-weight: 600;
    padding: 4px 2px 8px 2px;
}

QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    color: #1f2937;
    font-size: 14px;
    padding: 4px;
}

QListWidget::item {
    min-height: 38px;
    padding-left: 12px;
    padding-right: 10px;
    margin: 2px 0px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #eef4ff;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #0f4c81;
    font-weight: 600;
}

QLineEdit {
    min-height: 38px;
    background-color: #f9fafb;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
    selection-background-color: #bfdbfe;
}

QLineEdit:hover {
    border: 1px solid #9ca3af;
}

QLineEdit:focus {
    background-color: #ffffff;
    border: 2px solid #60a5fa;
}

QPushButton {
    min-height: 40px;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    padding: 0px 18px;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #cbd5e1;
    color: #64748b;
}

QMenuBar {
    background-color: #f3f6fb;
    color: #374151;
    border: none;
}

QMenuBar::item:selected {
    background-color: #e5e7eb;
    border-radius: 6px;
}

QStatusBar {
    background-color: #f3f6fb;
    color: #6b7280;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 28px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
]]></string>
  </property>

